    ]
  },
  { 
    icon: '🔍', 
    title: 'Диагностика', 
    desc: 'Компьютерная диагностика всех систем', 
    img: `${import.meta.env.BASE_URL}images/2026-11-03_14-54-59.png`,
    details: 'Компьютерная диагностика всех систем автомобиля. Современное оборудование.',
    prices: [
      { name: 'Компьютерная диагностика', price: 'от 500 ₽' },
      { name: 'Диагностика двигателя', price: 'от 800 ₽' },
      { name: 'Диагностика подвески', price: 'от 600 ₽' },
      { name: 'Проверка перед покупкой', price: 'от 1 500 ₽' },
    ]
  },
  { 
    icon: '⚙️', 
    title: 'Запчасти', 
    desc: 'Подбор и заказ оригинальных и аналогов', 
    img: `${import.meta.env.BASE_URL}images/2026-11-03_14-50-53.png`,
    details: 'Подбор и заказ оригинальных запчастей и качественных аналогов. Быстрая доставка.',
    prices: [
      { name: 'Подбор запчастей', price: 'бесплатно' },
      { name: 'Заказ оригинальных запчастей', price: 'по прайсу' },
      { name: 'Заказ аналогов', price: 'от 500 ₽' },
    ]
  },
];

const stats = [
  { value: '4.4', label: 'Рейтинг', suffix: '⭐' },
  { value: '361', label: 'Оценок', suffix: '' },
  { value: '175', label: 'Отзывов', suffix: '' },
  { value: '2026', label: 'Премия 2ГИС', suffix: '🏆' },
];

const reviews = [
  {
    name: 'Инесса Прокопьева',
    level: 'Знаток города 7 уровня',
    date: '8 декабря 2025',
    text: 'Ремонтирую машину только здесь. Мастера отличные! Знают свою работу, и делают всё быстро и качественно! Если нужно запчасти могут заказать. Рекомендую!😎',
  },
  {
    name: 'Пикабурики',
    level: 'Знаток города 6 уровня',
    date: '5 июня 2025',
    text: 'СТО хорошее, мастера знают своё дело. Выполняют все работы довольно быстро. Приезжал со своими запчастями, но можно заказать и у них.',
  },
  {
    name: 'Дима Самохин',
    level: 'Знаток города 3 уровня',
    date: '28 августа',
    text: 'Был в этом автосервисе, менял сцепление, работа была проведена на отлично! Алексею — огромное спасибо за работу. Всё понравилось, рекомендую!',
  },
  {
    name: 'Екатерина В.',
    level: 'Знаток города 6 уровня',
    date: '1 ноября 2025',
    text: 'Проверенные ребята, быстро, качественно и все по делу! Отличный ценник, посоветовали знакомые однажды, приезжаем теперь только сюда 🫶',
  },
  {
    name: 'Антон Жульков',
    level: 'Знаток города 11 уровня',
    date: '2 апреля 2025',
    text: 'Уже несколько лет переобуваю все авто в данном сервисе. Нареканий нет. Запись четко без ожиданий. Хорошая комната для ожидания.',
  },
  {
    name: 'Виктор',
    level: 'Знаток города 9 уровня',
    date: '22 января 2025',
    text: 'Мне нравится к ним ездить обслуживаться. Устраивает отношение, качество работ и запчастей, мойка тоже на отлично.',
  },
  {
    name: 'Виктория Абдуризаева',
    level: 'Знаток города 6 уровня',
    date: '7 ноября 2023',
    text: 'Очень хороший автосервис... Все объясняют, лишнего не накручивают. Были проблемы — позвонила, сразу предложили приехать. Теперь только в этот сервис.',
  },
  {
    name: 'Владимир Исаев',
    level: 'Знаток города 7 уровня',
    date: '19 июля 2025',
    text: 'Хороший автосервис. Решили проблему быстро и качественно. Всем советую👍👍👍',
  },
  {
    name: 'Алексей Кузнецов',
    level: 'Знаток города 3 уровня',
    date: '7 июня 2024',
    text: 'Отличный сервис, легко дозвониться и записаться. Хорошие мастера, посещаю данный сервис не первый раз, мойка тоже на высшем уровне.',
  },
  {
    name: 'Константин Широкожухов',
    level: 'Знаток города 2 уровня',
    date: '2 апреля 2021',
    text: 'Постоянно посещаю СТО Конюшню. Качество обслуживания на отличном уровне. Все работы выполняются качественно и быстро. Особенно хочу выделить мойку в лице мойщика Ивана.',
  },
];

const advantages = [
  { percent: '73%', label: 'Положительных отзывов о персонале' },
  { percent: '88%', label: 'Довольны временем ожидания' },
  { percent: '100%', label: 'Оценили комнату ожидания' },
  { percent: '85%', label: 'Положительных отзывов о запчастях' },
];
---

<Layout title="Конюшни — автосервис в Липецке | Премия 2ГИС 2026">
  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900"></div>
    <div class="absolute inset-0 opacity-30" style={`background-image: url('${import.meta.env.BASE_URL}images/2026-11-03_14-50-15.png'); background-size: cover; background-position: center;`}></div>
    
    <div class="relative z-10 container mx-auto px-4 py-20 text-center">
      <div class="inline-block mb-6 px-4 py-2 bg-yellow-500/20 border border-yellow-500/50 rounded-full">
        <span class="text-yellow-400 font-semibold">🏆 Лучший автосервис 2026 по версии 2ГИС</span>
      </div>
      
      <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight">КОНЮШНИ</h1>
      
      <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-2xl mx-auto">
        Автосервис, автотехцентр, магазин автозапчастей и автомойка в Липецке
      </p>
      
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <div class="flex items-center gap-2 px-6 py-3 bg-gray-800/50 backdrop-blur rounded-lg border border-gray-700">
          <span class="text-2xl">⭐</span>
          <span class="text-xl font-bold">4.4</span>
          <span class="text-gray-400">/ 361 оценка</span>
        </div>
        <div class="flex items-center gap-2 px-6 py-3 bg-gray-800/50 backdrop-blur rounded-lg border border-gray-700">
          <span class="text-2xl">💬</span>
          <span class="text-xl font-bold">175</span>
          <span class="text-gray-400">отзывов</span>
        </div>
      </div>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`tel:${phone}`} class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-lg transition-all duration-300 hover:scale-105 shadow-lg shadow-green-600/30">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {phoneDisplay}
        </a>
        
        <a href={yandexMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold text-lg rounded-lg transition-all duration-300 hover:scale-105 shadow-lg shadow-blue-600/30">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Построить маршрут
        </a>
      </div>
    </div>
    
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="py-20 bg-gray-800">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Наши услуги</h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Полный спектр услуг для отечественных, легковых и импортных автомобилей
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service, idx) => (
          <button 
            type="button"
            class="group bg-gray-900 rounded-xl border border-gray-700 hover:border-yellow-500/50 transition-all duration-300 hover:-translate-y-1 overflow-hidden text-left cursor-pointer"
            onclick={`openModal(${idx})`}
          >
            <div class="h-48 overflow-hidden">
              <img src={service.img} alt={service.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="p-6">
              <div class="text-3xl mb-3">{service.icon}</div>
              <h3 class="text-xl font-bold mb-2 group-hover:text-yellow-400 transition-colors">{service.title}</h3>
              <p class="text-gray-400">{service.desc}</p>
              <div class="mt-4 text-yellow-400 text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">Нажмите для подробностей →</div>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Modals -->
  {services.map((service, idx) => (
    <div id={`modal-${idx}`} class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm" onclick={`closeModal(${idx})`}>
      <div class="bg-gray-900 rounded-2xl border border-gray-700 max-w-lg w-full max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
        <div class="relative">
          <img src={service.img} alt={service.title} class="w-full h-56 object-cover rounded-t-2xl" />
          <button type="button" class="absolute top-4 right-4 w-10 h-10 bg-black/50 hover:bg-black/70 rounded-full flex items-center justify-center text-white text-xl transition-colors" onclick={`closeModal(${idx})`}>✕</button>
        </div>
        <div class="p-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-4xl">{service.icon}</span>
            <h3 class="text-2xl font-bold text-yellow-400">{service.title}</h3>
          </div>
          <p class="text-gray-300 mb-6">{service.details}</p>
          <h4 class="text-lg font-bold mb-4 text-white">Цены:</h4>
          <div class="space-y-3">
            {service.prices.map((item) => (
              <div class="flex justify-between items-center py-2 border-b border-gray-800">
                <span class="text-gray-300">{item.name}</span>
                <span class="text-yellow-400 font-bold">{item.price}</span>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-4 border-t border-gray-800">
            <a href={`tel:${phone}`} class="block w-full py-3 bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold text-center rounded-lg transition-colors">
              Позвонить и записаться
            </a>
          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- Why Us / Stats -->
  <section class="py-20 bg-gray-900">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Почему выбирают нас</h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Цифры говорят сами за себя — реальные отзывы с Яндекс.Карт
      </p>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
        {stats.map((stat) => (
          <div class="text-center p-6 bg-gray-800 rounded-xl border border-gray-700">
            <div class="text-4xl md:text-5xl font-bold text-yellow-400 mb-2">
              {stat.value}{stat.suffix}
            </div>
            <div class="text-gray-400">{stat.label}</div>
          </div>
        ))}
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {advantages.map((adv) => (
          <div class="flex items-center gap-4 p-6 bg-gray-800 rounded-xl border border-gray-700">
            <div class="text-3xl font-bold text-green-400 min-w-[80px]">{adv.percent}</div>
            <div class="text-gray-300">{adv.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="py-20 bg-gray-800">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Фотографии</h2>
      <p class="text-gray-400 text-center mb-12">Реальные фото с Яндекс.Карт</p>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 max-w-6xl mx-auto">
        {['2026-11-03_14-50-15.png', '2026-11-03_14-51-17.png', '2026-11-03_14-52-01.png', '2026-11-03_14-53-31.png', '2026-11-03_14-51-39.png'].map((photo) => (
          <div class="rounded-xl overflow-hidden border border-gray-700 hover:border-yellow-500/50 transition-all duration-300">
            <img src={`${import.meta.env.BASE_URL}images/${photo}`} alt="Конюшни — автосервис" class="w-full h-40 object-cover hover:scale-110 transition-transform duration-500" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reviews Carousel -->
  <section class="py-20 bg-gray-800 overflow-hidden">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Отзывы клиентов</h2>
      <p class="text-gray-400 text-center mb-12">Реальные отзывы с Яндекс.Карт</p>
      
      <div class="relative max-w-4xl mx-auto">
        <!-- Carousel container -->
        <div id="carousel" class="flex transition-transform duration-500 ease-in-out">
          {reviews.map((review, idx) => (
            <div class="w-full flex-shrink-0 px-4">
              <div class="p-8 bg-gray-900 rounded-2xl border border-gray-700 text-center">
                <div class="w-20 h-20 bg-yellow-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
                  <span class="text-yellow-400 font-bold text-3xl">{review.name[0]}</span>
                </div>
                <div class="font-bold text-lg mb-1">{review.name}</div>
                <div class="text-sm text-gray-400 mb-2">{review.level}</div>
                {review.date && <div class="text-xs text-gray-500 mb-4">{review.date}</div>}
                <p class="text-gray-300 leading-relaxed text-lg">"{review.text}"</p>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Navigation buttons -->
        <button type="button" onclick="prevSlide()" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 w-12 h-12 bg-yellow-500 hover:bg-yellow-400 text-gray-900 rounded-full flex items-center justify-center text-xl font-bold transition-all hover:scale-110 z-10">
          ←
        </button>
        <button type="button" onclick="nextSlide()" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-12 h-12 bg-yellow-500 hover:bg-yellow-400 text-gray-900 rounded-full flex items-center justify-center text-xl font-bold transition-all hover:scale-110 z-10">
          →
        </button>
        
        <!-- Dots -->
        <div class="flex justify-center gap-2 mt-8">
          {reviews.map((_, idx) => (
            <button type="button" onclick={`goToSlide(${idx})`} class="w-3 h-3 rounded-full bg-gray-600 hover:bg-yellow-400 transition-colors carousel-dot" data-slide={idx}></button>
          ))}
        </div>
      </div>
      
      <div class="text-center mt-8">
        <a href={yandexMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-yellow-400 hover:text-yellow-300 transition-colors">
          Читать все 175 отзывов на Яндекс.Картах
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Contacts -->
  <section id="contacts" class="py-20 bg-gray-900">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Контакты</h2>
      <p class="text-gray-400 text-center mb-12">Приезжайте — мы всегда рады помочь</p>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="space-y-6">
          <div class="flex items-start gap-4 p-6 bg-gray-800 rounded-xl border border-gray-700">
            <div class="text-2xl">📍</div>
            <div>
              <div class="font-bold mb-1">Адрес</div>
              <div class="text-gray-400">{address}</div>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-6 bg-gray-800 rounded-xl border border-gray-700">
            <div class="text-2xl">📞</div>
            <div>
              <div class="font-bold mb-1">Телефон</div>
              <a href={`tel:${phone}`} class="text-yellow-400 hover:text-yellow-300 transition-colors text-lg">{phoneDisplay}</a>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-6 bg-gray-800 rounded-xl border border-gray-700">
            <div class="text-2xl">🕐</div>
            <div>
              <div class="font-bold mb-1">Время работы</div>
              <div class="text-gray-400">Ежедневно с 9:00 до 21:00, без перерыва и выходных</div>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-6 bg-gray-800 rounded-xl border border-gray-700">
            <div class="text-2xl">🚗</div>
            <div>
              <div class="font-bold mb-1">Марки автомобилей</div>
              <div class="text-gray-400">Отечественные, легковые, импортные</div>
            </div>
          </div>
        </div>
        
        <div class="rounded-xl overflow-hidden border border-gray-700 h-96 lg:h-auto">
